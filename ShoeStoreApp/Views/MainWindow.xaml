<Window x:Class="ShoeStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог товаров - Магазин обуви"
        Height="650" Width="1050"
        MinHeight="550" MinWidth="900"
        Icon="/Resources/logo.png"
        FontFamily="Times New Roman"
        Background="{StaticResource MainBackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <DockPanel Background="{StaticResource MainBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource AdditionalBackgroundBrush}" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Height="38" Stretch="Uniform" Source="/Resources/logo.png"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="Магазин обуви" Foreground="Black" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="Каталог товаров" Foreground="Black" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <Button x:Name="btnAddProduct"
                        Grid.Column="1"
                        Content="Добавить товар"
                        Width="145" Height="34"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ActionBrush}" Foreground="Black"
                        Click="btnAddProduct_Click"
                        Visibility="Collapsed"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                        <TextBlock x:Name="lblUserFio" Foreground="Black" FontSize="14" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="lblUserRole" Foreground="Black" FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Button x:Name="btnLogout"
                            Content="Назад к входу"
                            Width="115" Height="30"
                            Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="filterPanel"
                DockPanel.Dock="Top"
                Margin="12,12,12,6"
                Padding="12"
                Background="{StaticResource MainBackgroundBrush}"
                BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Поиск по текстовым данным" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtSearch"
                             Margin="0,5,0,0"
                             Height="28"
                             ToolTip="Можно ввести несколько слов: каждое слово будет найдено в доступных текстовых полях товара."
                             TextChanged="txtSearch_TextChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Поставщик" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbSupplierFilter"
                              Margin="0,5,0,0"
                              Height="28"
                              SelectionChanged="cmbSupplierFilter_SelectionChanged"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Количество на складе" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbQuantitySort"
                              Margin="0,5,0,0"
                              Height="28"
                              SelectedIndex="0"
                              SelectionChanged="cmbQuantitySort_SelectionChanged">
                        <ComboBoxItem Content="Без сортировки" Tag=""/>
                        <ComboBoxItem Content="По возрастанию" Tag="Quantity ASC"/>
                        <ComboBoxItem Content="По убыванию" Tag="Quantity DESC"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource AdditionalBackgroundBrush}" Padding="12,7">
            <TextBlock x:Name="lblProductCount" Foreground="Black"/>
        </Border>

        <ScrollViewer Margin="12,6,12,6" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="itemsProducts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                Background="{StaticResource MainBackgroundBrush}"
                                BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                                BorderThickness="1"
                                MouseLeftButtonUp="ProductBorder_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Margin="8"
                                        BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                                        BorderThickness="1">
                                    <Image Width="200" Height="145"
                                           Stretch="Uniform"
                                           Source="{Binding PhotoImage}"/>
                                </Border>

                                <Border Grid.Column="1"
                                        Margin="0,8"
                                        Padding="14,8"
                                        BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock FontSize="17" FontWeight="Bold" TextWrapping="Wrap">
                                            <Run Text="{Binding Category}"/>
                                            <Run Text=" | "/>
                                            <Run Text="{Binding Name}"/>
                                        </TextBlock>
                                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="Описание товара: "/><Run Text="{Binding Description}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Производитель: "/><Run Text="{Binding Brand}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="Поставщик: "/><Run Text="{Binding Supplier}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Цена: "/>
                                            <Run Text="{Binding Price, StringFormat={}{0:N2}}" FontWeight="Bold"/>
                                            <Run Text=" руб."/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Единица измерения: "/><Run Text="{Binding UnitOfMeasure}"/>
                                        </TextBlock>
                                        <TextBlock>
                                            <Run Text="Количество на складе: "/><Run Text="{Binding Quantity}" FontWeight="Bold"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2"
                                        Margin="0,8,8,8"
                                        BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Действующая"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="скидка"
                                                       HorizontalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,6,0,0"
                                                       HorizontalAlignment="Center"
                                                       FontSize="18"
                                                       FontWeight="Bold">
                                                <Run Text="{Binding Discount, StringFormat={}{0:N2}}"/>
                                                <Run Text="%"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <Button Content="Удалить"
                                                Width="105" Height="28"
                                                Margin="8"
                                                VerticalAlignment="Bottom"
                                                HorizontalAlignment="Center"
                                                Tag="{Binding ProductID}"
                                                Click="btnDeleteProduct_Click"
                                                Visibility="{Binding AdminActionsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
