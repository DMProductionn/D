<Window x:Class="ShoeStoreApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин обуви" 
        Height="550" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <DockPanel>
        <!-- Верхняя панель -->
        <Border DockPanel.Dock="Top" Background="#2C3E50" Height="50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0">
                    <Image Width="40" Height="40" Source="/Resources/logo.png"/>
                    <TextBlock Text="Магазин обуви" Foreground="White" FontSize="16" Margin="10,0"/>
                </StackPanel>

                <!-- Кнопка добавления товара (видна только админу) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                    <Button x:Name="btnAddProduct" Content="➕ Добавить товар" 
                            Width="120" Height="35" Background="Green" Foreground="White"
                            Click="btnAddProduct_Click" Visibility="Collapsed"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,15,0">
                    <TextBlock x:Name="lblUserFio" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="lblUserRole" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <Button x:Name="btnLogout" Content="Выйти" Width="80" Height="30"
                            Background="#E74C3C" Foreground="White" Click="btnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Список товаров с кнопкой удаления у каждого -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="itemsProducts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10" Margin="5,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Фото -->
                                <Image Grid.Column="0" Width="80" Height="80" Stretch="Uniform"
                                       Source="{Binding PhotoImage}"/>

                                <!-- Информация -->
                                <StackPanel Grid.Column="1" Margin="15,5">
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock><Run Text="Категория: "/><Run Text="{Binding Category}"/></TextBlock>
                                    <TextBlock><Run Text="Описание: "/><Run Text="{Binding Description}"/></TextBlock>
                                    <TextBlock><Run Text="Производитель: "/><Run Text="{Binding Brand}"/></TextBlock>
                                    <TextBlock><Run Text="Поставщик: "/><Run Text="{Binding Supplier}"/></TextBlock>
                                    <TextBlock><Run Text="Цена: "/><Run Text="{Binding Price, StringFormat={}{0:N0}}" Foreground="Red"/><Run Text=" руб."/></TextBlock>
                                    <TextBlock><Run Text="Кол-во: "/><Run Text="{Binding Quantity}"/></TextBlock>
                                </StackPanel>

                                <!-- Кнопка удаления -->
                                <Button Grid.Column="2" 
                                        Content="❌ Удалить" 
                                        Width="80" Height="30"
                                        Background="#E74C3C" 
                                        Foreground="White"
                                        Tag="{Binding ProductID}"
                                        Click="btnDeleteProduct_Click"
                                        x:Name="btnDelete"
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>