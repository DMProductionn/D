<Window x:Class="ShoeStoreApp.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара - Магазин обуви"
        Height="760" Width="690"
        MinHeight="620" MinWidth="620"
        Icon="/Resources/logo.png"
        FontFamily="Times New Roman"
        Background="{StaticResource MainBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <DockPanel Background="{StaticResource MainBackgroundBrush}">
        <Border DockPanel.Dock="Top" Background="{StaticResource AdditionalBackgroundBrush}" Padding="16,12">
            <TextBlock x:Name="lblHeading"
                       Text="Добавление товара"
                       Foreground="Black"
                       FontSize="20"
                       FontWeight="Bold"/>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="14" Background="{StaticResource AdditionalBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnBack"
                        Content="Назад"
                        Width="105" Height="34"
                        Margin="0,0,8,0"
                        Click="btnBack_Click"/>
                <Button x:Name="btnSave"
                        Content="Сохранить"
                        Width="125" Height="34"
                        Background="{StaticResource ActionBrush}" Foreground="Black"
                        Click="btnSave_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="panelProductId"
                            Grid.Row="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">
                    <TextBlock Text="ID товара:" Width="185" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtProductId" Width="180" IsReadOnly="True"
                             Background="{StaticResource AdditionalBackgroundBrush}"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="Фото товара:" VerticalAlignment="Top"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                    <Border Width="310" Height="210"
                            HorizontalAlignment="Left"
                            BorderBrush="{StaticResource AdditionalBackgroundBrush}"
                            BorderThickness="1"
                            Background="{StaticResource MainBackgroundBrush}">
                        <Image x:Name="imgPhoto" Width="300" Height="200" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                        <Button x:Name="btnSelectPhoto"
                                Content="Выбрать изображение"
                                Width="165" Height="28"
                                Click="btnSelectPhoto_Click"/>
                        <TextBlock Text=" Максимум 300x200 пикселей"
                                   Foreground="Black"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="Артикул:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtArticle" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Введите артикул товара."/>

                <TextBlock Grid.Row="3" Text="Наименование товара:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Обязательное поле."/>

                <TextBlock Grid.Row="4" Text="Категория товара:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbCategory" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                          IsEditable="True"
                          ToolTip="Выберите существующую категорию или введите новую."/>

                <TextBlock Grid.Row="5" Text="Описание товара:" VerticalAlignment="Top"/>
                <TextBox x:Name="txtDescription" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"
                         Height="62" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Grid.Row="6" Text="Производитель:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbBrand" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8"
                          IsEditable="True"
                          ToolTip="Выберите существующего производителя или введите нового."/>

                <TextBlock Grid.Row="7" Text="Поставщик:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbSupplier" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8"
                          IsEditable="True"
                          ToolTip="Выберите существующего поставщика или введите нового."/>

                <TextBlock Grid.Row="8" Text="Цена:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPrice" Grid.Row="8" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Введите неотрицательное число. Допускаются сотые части, например 2499,90."/>

                <TextBlock Grid.Row="9" Text="Единица измерения:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbUnitOfMeasure" Grid.Row="9" Grid.Column="1" Margin="0,0,0,8"
                          IsEditable="True"
                          ToolTip="Например: шт."/>

                <TextBlock Grid.Row="10" Text="Количество на складе:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtQuantity" Grid.Row="10" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Введите целое неотрицательное число."/>

                <TextBlock Grid.Row="11" Text="Действующая скидка, %:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtDiscount" Grid.Row="11" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="Введите значение от 0 до 100."/>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
