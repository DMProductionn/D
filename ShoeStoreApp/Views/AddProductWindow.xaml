<Window x:Class="ShoeStoreApp.Views.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление товара" Height="500" Width="400"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <TextBlock Text="Добавление нового товара" FontSize="20" Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <TextBlock Text="Артикул:"/>
        <TextBox x:Name="txtArticle" Margin="0,5,0,10"/>

        <TextBlock Text="Наименование:"/>
        <TextBox x:Name="txtName" Margin="0,5,0,10"/>

        <TextBlock Text="Категория:"/>
        <TextBox x:Name="txtCategory" Margin="0,5,0,10"/>

        <TextBlock Text="Описание:"/>
        <TextBox x:Name="txtDescription" Margin="0,5,0,10" Height="60" TextWrapping="Wrap"/>

        <TextBlock Text="Производитель:"/>
        <TextBox x:Name="txtBrand" Margin="0,5,0,10"/>

        <TextBlock Text="Поставщик:"/>
        <TextBox x:Name="txtSupplier" Margin="0,5,0,10"/>

        <TextBlock Text="Цена:"/>
        <TextBox x:Name="txtPrice" Margin="0,5,0,10"/>

        <TextBlock Text="Количество:"/>
        <TextBox x:Name="txtQuantity" Margin="0,5,0,10"/>

        <TextBlock Text="Название файла фото (например, 1.jpg):"/>
        <TextBox x:Name="txtPhotoPath" Margin="0,5,0,10" Text=""/>

        <Button x:Name="btnSave" Content="Сохранить" Height="40" Margin="0,20,0,0" 
                Background="Green" Foreground="White" Click="btnSave_Click"/>
        <Button x:Name="btnCancel" Content="Отмена" Height="30" Margin="0,5,0,0" Click="btnCancel_Click"/>
    </StackPanel>
</Window>